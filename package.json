{
  "name": "pexx-brain-graph-viewer",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.1",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.67.0",
    "marked": "^18.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.pexxindustries.brain",
    "productName": "Pexx Brain",
    "artifactName": "pexx-brain-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "linux": { "target": ["AppImage"], "category": "Utility", "executableName": "pexx-brain" },
    "asar": true
  }
}
